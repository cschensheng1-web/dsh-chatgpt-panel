{
  "name": "dsh-chatgpt-panel",
  "version": "0.1.0-preview.2",
  "description": "ChatGPT-style DeepSeek web companion for DSH Desktop (experimental DOM bridge, no paid model fallback)",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "scripts",
    "tests",
    "docs",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "node scripts/build.mjs && node scripts/preview.mjs",
    "check": "npm run build && npm test",
    "test:ui": "node scripts/build.mjs && node scripts/test-ui.mjs",
    "test:dom": "node scripts/test-dom.mjs"
  },
  "dependencies": {
    "playwright-core": "1.56.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "marked": "16.4.1",
    "dompurify": "3.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cschensheng1-web/dsh-chatgpt-panel.git"
  },
  "homepage": "https://github.com/cschensheng1-web/dsh-chatgpt-panel#readme",
  "bugs": {
    "url": "https://github.com/cschensheng1-web/dsh-chatgpt-panel/issues"
  }
}
